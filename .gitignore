# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/

# Bootstrap logs
.setup.log
.setup.out
.fetch.log
*.part

# Downloaded geodata (~91 MB). Public domain, but there is no reason to carry
# it in git: `python scripts/fetch_data.py` reproduces it byte for byte and
# records checksums in data/MANIFEST.json.
data/naturalearth/

# Vendored MapLibre GL JS (BSD-3-Clause), fetched by the same script.
mapify/web/vendor/

# Generated from the Natural Earth 110m layer by scripts/fetch_data.py.
mapify/web/data/

# Runtime state: lookup cache and any local config the user writes.
data/cache/
config.toml

# Model weights are cached by huggingface_hub under the user profile, not here,
# but guard against a stray local cache anyway.
.cache/
models_cache/

# Sample images a user drops in for testing are theirs, not ours.
samples/private/

# OS noise
Thumbs.db
.DS_Store
desktop.ini

# NASA Earth textures (~3 MB), fetched by scripts/fetch_textures.py.
mapify/web/textures/
samples/

# Scratch logs from local runs.
.app.log
.svc.log
.eval.log
.tex.log
.warm.log
.server.log

# PyInstaller output and its generated spec.
build/
dist/
Mapify.spec

# Rendered test boards and anything a user drops in to try.
samples/private/

# The installed application, its caches and its 2.2 GB of model weights.
# install.ps1 puts all of it here by default, inside the project, which is
# the whole point -- everything on one drive, next to the source. None of
# it is source: it is 3.35 GB of build output and downloaded weights, and
# `git add -A` will hoover it up given half a chance. It did, once.
app/

# Reports the application exported. Somebody's output, not the project's.
exports/

# Benchmark output. Reproducible from scripts/evaluate.py, and a JSON row
# per sample times a run per experiment adds up fast.
bench/

# Local geographic data built on this machine. OpenStreetMap extracts are
# hundreds of megabytes and the store built from them is a derivative
# database under ODbL: it is regenerated here, never redistributed.
data/osm/
data/geodata/
data/tiles/
data/tmp/
data/cases/
data/*.log
